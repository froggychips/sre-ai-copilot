# SRE AI Copilot Configuration

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Discord Configuration
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_BOT_TOKEN=your_bot_token_if_using_client

# Kubernetes Settings
K8S_CONTEXT=lastoasisgame-local
SAFE_MODE=true
APPROVAL_REQUIRED=true

# FastAPI Settings
API_DEBUG=false
PORT=8000

# TeamCity REST API — для обогащения incident-а контекстом «recent deploys».
# TC_TOKEN — TeamCity personal access token (создаётся в TC profile).
# Переиспользуется тот же токен, что у mcp-teamcity stdio MCP.
TC_URL=https://wo-teamcity.lastoasisgame.com
TC_TOKEN=
TC_TIMEOUT_SECONDS=5
TC_LOOKBACK_MINUTES=60
TC_BACKEND_PROJECT_ID=Wo_Backend_K8sNewCluster

# Pull-mode adapter (scripts/pull_alertmanager.py) — локальная разработка на Mac.
# Поднять port-forward в отдельной shell:
#   kubectl port-forward -n monitoring svc/vmalertmanager-vm-victoria-metrics-k8s-stack 9093:9093
ALERTMANAGER_URL=http://localhost:9093
SRE_COPILOT_URL=http://localhost:8000
POLL_INTERVAL_SECONDS=30
# DRY_RUN=true                                  # печатать payload, не POST-ить
# FILTER=severity=critical,namespace=prod-shared
# INCLUDE_INHIBITED=false
# INCLUDE_SILENCED=false
