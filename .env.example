# SRE AI Copilot Configuration — example values.
# Скопируй в .env и заполни под свою инфраструктуру.

# === LLM ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_BACKEND=anthropic                      # anthropic | claude_cli

# === Хранилища ===
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://user:pass@postgres:5432/sre_copilot

# === Discord (опционально) ===
DISCORD_WEBHOOK_URL=                       # webhook канала #error (incident embed-ы)
DISCORD_WEBHOOK_STATS_URL=                 # webhook канала #stats (cluster-health daily report)
DISCORD_PUBLIC_KEY=                        # Ed25519 public key (Developer Portal → General Information)
DISCORD_APPLICATION_ID=                    # Application ID (для deferred-response followups в apply-flow)
DISCORD_INTERACTION_MAX_AGE_SECONDS=300    # anti-replay: окно свежести X-Signature-Timestamp (0 = выкл)

# === K8s ===
K8S_CONTEXT=                               # имя контекста kubectl (если не дефолтный)
SAFE_MODE=true                             # запрет любых write-операций без post_approval
APPROVAL_REQUIRED=true

# === FastAPI ===
API_DEBUG=false
PORT=8000

# === AlertManager (HMAC auth) ===
ALERTMANAGER_WEBHOOK_SECRET=               # обязателен в production — HMAC-SHA256 на body
ALERTMANAGER_WEBHOOK_MAX_AGE_SECONDS=300   # anti-replay: окно свежести X-Alertmanager-Timestamp (если signer его шлёт)
ALERTMANAGER_REQUIRE_SIGNED_TIMESTAMP=false # true → отклонять body-only подпись без timestamp

# === Executor (opt-in, v0.7.0+) ===
EXECUTOR_ENABLED=false                     # включает 9-ю стадию (kubectl --dry-run=server)
EXECUTOR_APPROVAL_ENABLED=false            # включает Apply-кнопку в Discord embed (real kubectl)

# === KG topology auto-sync ===
KG_SCAN_NAMESPACES=                        # comma-separated namespaces; пусто → auto-discovery

# === TeamCity (опционально) ===
TC_URL=                                    # https://<your-teamcity>.example.com
TC_TOKEN=                                  # Bearer-токен
TC_BACKEND_PROJECT_ID=                     # ID build configuration / project
TEAMCITY_MCP_URL=                          # fallback через MCP-server (http://127.0.0.1:8001/mcp для local PoC)
TEAMCITY_MCP_TOKEN=
TEAMCITY_WEB_URL=                          # web UI base — для viewLog ссылок в Discord
TC_TIMEOUT_SECONDS=5
TC_LOOKBACK_MINUTES=60

# === GitLab (опционально) ===
GITLAB_URL=                                # https://<your-gitlab>.example.com
GITLAB_TOKEN=                              # Personal Access Token (read_api)
GITLAB_BACKEND_PROJECT=                    # <group>/<repo> для MR-enrichment

# === VictoriaMetrics (опционально) ===
VICTORIA_METRICS_URL=                      # пример: http://vmsingle-vm-victoria-metrics-k8s-stack.monitoring:8428
VICTORIA_METRICS_WINDOW_MINUTES=15

# === ClickHouse (blast-radius enrichment, опционально) ===
CH_PROD_HOST=
CH_PROD_PORT=8443
CH_PROD_USER=
CH_PROD_PASSWORD=
CH_BLAST_RADIUS_WINDOW_MINUTES=15

# === Statics Postgres (DI-error enrichment, опционально) ===
STATICS_HOST=
STATICS_PORT=5432
STATICS_USER=
STATICS_PASSWORD=
STATICS_RECENT_VERSIONS=5

# === Seq log aggregator (опционально, для kg_log_observations) ===
# Layout WO: на каждом wo-api{N}-prod /seq/ + один в ns `logging`.
# Beat-task `kg_seq_logs_sync` каждые 10 мин агрегирует Error/Fatal
# per service per окно и пишет в kg_log_observations.
#
# Способ 1: полный JSON список (предпочтительно — даёт namespace-hint):
SEQ_INSTANCES=                              # [{"name":"prod","url":"...","token":"...","namespace":"prod-shared"}]
# Способ 2: одиночные ENV (если SEQ_INSTANCES пуст, используются эти).
SEQ_URL_PROD=                               # https://wo-api1-prod.lastoasisgame.com/seq
SEQ_TOKEN_PROD=                             # X-Seq-ApiKey
SEQ_URL_PREPROD=
SEQ_TOKEN_PREPROD=
SEQ_URL_PREUPDATE=
SEQ_TOKEN_PREUPDATE=

# === Atlassian Jira (опционально) ===
JIRA_BASE_URL=                             # https://<your-org>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=                          # e.g. PROJ
JIRA_BACKEND_LABEL=backend
JIRA_SEARCH_DAYS=30

# === OTEL ===
# Пусто → traces НЕ экспортируются (setup_telemetry probe-reachability + graceful-degrade).
# Пример: http://tempo.monitoring:4317
OTLP_EXPORTER_ENDPOINT=

# === Pull-mode adapter (scripts/pull_alertmanager.py — local dev) ===
ALERTMANAGER_URL=http://localhost:9093
SRE_COPILOT_URL=http://localhost:8000
POLL_INTERVAL_SECONDS=30
# DRY_RUN=true                             # печатать payload, не POST-ить
# FILTER=severity=critical                 # фильтр по labels
# INCLUDE_INHIBITED=false
# INCLUDE_SILENCED=false
