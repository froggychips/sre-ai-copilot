# Secret роли beat: `sre-ai-beat-secrets` (Deployment copilot-beat).
#
# ШАБЛОН С ИМЕНАМИ КЛЮЧЕЙ. Сам Secret в git не хранится.
#
# beat только публикует задачи по расписанию (beat_schedule в
# app/workers/tasks.py): ему нужен брокер. Флаги задач (дайджесты, бэкфил)
# читает воркер, который задачу исполняет, а не beat.
#
#   REDIS_URL    — брокер Celery;
#   DATABASE_URL — beat к базе НЕ подключается (движок SQLAlchemy создаётся при
#                  импорте, соединение — лениво), но Settings с ENV=production
#                  отказывается стартовать на плейсхолдерном значении
#                  (app/config.py, _enforce_prod_invariants). Пока валидатор
#                  устроен так, ключ обязателен.
#
# Создать из действующего sre-ai-secrets, не выводя значений:
#   python3 scripts/split_role_secrets.py apply beat
apiVersion: v1
kind: Secret
metadata:
  name: sre-ai-beat-secrets
type: Opaque
stringData:
  REDIS_URL: "REPLACE_ME"
  DATABASE_URL: "REPLACE_ME"
  OTLP_EXPORTER_ENDPOINT: "REPLACE_ME"  # optional — без него трейсы beat не экспортируются
