# ExternalSecret шаблон (external-secrets.io v1beta1).
# Использовать, когда уже есть централизованный secret store (Vault/AWS SM/GCP SM).
#
# Требуется установленный External Secrets Operator:
#   helm repo add external-secrets https://charts.external-secrets.io
#   helm install external-secrets external-secrets/external-secrets -n external-secrets --create-namespace
#
# 1) SecretStore (cluster или namespace scope) — настраивает auth к backend-у.
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: sre-ai-secret-store
spec:
  provider:
    # Пример AWS Secrets Manager. Замените на свой backend (vault, gcpsm, kubernetes).
    aws:
      service: SecretsManager
      region: eu-west-1
      auth:
        jwt:
          serviceAccountRef:
            name: sre-ai  # должен иметь IRSA-аннотацию
---
# 2) ExternalSecret — описывает, какие ключи и из какого секрета забирать.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: sre-ai-secrets
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: sre-ai-secret-store
    kind: SecretStore
  target:
    name: sre-ai-secrets
    creationPolicy: Owner
  data:
  - secretKey: ANTHROPIC_API_KEY
    remoteRef:
      key: prod/sre-ai/anthropic
      property: api_key
  - secretKey: DATABASE_URL
    remoteRef:
      key: prod/sre-ai/postgres
      property: connection_string
  - secretKey: REDIS_URL
    remoteRef:
      key: prod/sre-ai/redis
      property: connection_string
  - secretKey: DISCORD_WEBHOOK_URL
    remoteRef:
      key: prod/sre-ai/discord
      property: webhook_url
  - secretKey: ALERTMANAGER_WEBHOOK_SECRET
    remoteRef:
      key: prod/sre-ai/alertmanager
      property: hmac_secret
