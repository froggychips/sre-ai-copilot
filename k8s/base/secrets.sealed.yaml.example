# SealedSecret шаблон. Генерация:
#
#   # 1. Подготовить plain Secret локально (не коммитить!):
#   kubectl create secret generic sre-ai-secrets \
#       --from-literal=ANTHROPIC_API_KEY=sk-ant-... \
#       --from-literal=DATABASE_URL='postgresql://...' \
#       --from-literal=REDIS_URL='redis://redis:6379/0' \
#       --from-literal=DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/...' \
#       --from-literal=ALERTMANAGER_WEBHOOK_SECRET="$(openssl rand -hex 32)" \
#       --dry-run=client -o yaml > /tmp/plain-secrets.yaml
#
#   # 2. Запечатать публичным ключом cluster-овского контроллера:
#   kubeseal --controller-namespace kube-system \
#       --format yaml \
#       < /tmp/plain-secrets.yaml > k8s/base/secrets.sealed.yaml
#
#   # 3. plain-secrets удалить, sealed — закоммитить. SealedSecret-controller
#   #    расшифрует в реальный Secret внутри cluster-а.
#
# Пример выхода kubeseal:
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: sre-ai-secrets
  namespace: default
spec:
  encryptedData:
    ANTHROPIC_API_KEY: AgB1...заменить-на-вывод-kubeseal...==
    DATABASE_URL: AgB1...==
    REDIS_URL: AgB1...==
    DISCORD_WEBHOOK_URL: AgB1...==
    ALERTMANAGER_WEBHOOK_SECRET: AgB1...==
  template:
    metadata:
      name: sre-ai-secrets
    type: Opaque
