# Secret `sre-ai-secrets` — api, copilot-worker, copilot-worker-sync, Job
# миграций; CronJob squad-dashboard берёт из него один ключ DATABASE_URL.
#
# ШАБЛОН С ИМЕНАМИ КЛЮЧЕЙ в том составе, который должен остаться после
# миграции 18.11.2026 (docs/RUNBOOK.ru.md, «Настройки: ConfigMap и секреты по
# ролям»). Сам Secret в git не хранится. Для local kind/minikube есть короткий
# k8s/base/secrets.yaml.
#
# Чего здесь больше НЕТ: несекретных флагов поведения — ENV, LLM_BACKEND,
# PYTHONPATH, DISCORD_DRY_RUN, DISCORD_ENRICH_ENABLED, EXECUTOR_ENABLED,
# EXECUTOR_APPROVAL_ENABLED, REMEDIATION_BRIDGE_ENABLED,
# KG_METRICS_SYNC_CONCURRENCY. Они в k8s/base/settings.yaml; ENV — литерал в
# Deployment-ах. tests/test_settings_configmap.py не даст вернуть сюда ключ,
# который уже есть в ConfigMap.
#
# Кто что читает (по коду, 18.11.2026). api не нужны CH_PROD_*, GITLAB_*,
# SEQ_INSTANCES — следующий шаг разделения, см. RUNBOOK.
apiVersion: v1
kind: Secret
metadata:
  name: sre-ai-secrets
type: Opaque
stringData:
  # ── хранилища ──────────────────────────────────────────────────────────
  DATABASE_URL: "REPLACE_ME"
  REDIS_URL: "REPLACE_ME"
  # ── LLM ────────────────────────────────────────────────────────────────
  ANTHROPIC_API_KEY: "REPLACE_ME"
  # ── Discord ────────────────────────────────────────────────────────────
  DISCORD_BOT_TOKEN: "REPLACE_ME"
  DISCORD_PUBLIC_KEY: "REPLACE_ME"
  DISCORD_WEBHOOK_URL: "REPLACE_ME"
  DISCORD_WEBHOOK_STATS_URL: "REPLACE_ME"
  DISCORD_WEBHOOK_SELF_HEALTH_URL: "REPLACE_ME"
  DISCORD_INCIDENT_CHANNEL_ID: "REPLACE_ME"
  DISCORD_APPROVERS_USER_IDS: "REPLACE_ME"
  DISCORD_ALERT_MENTION_ROLE_ID: "REPLACE_ME"
  DISCORD_ALERT_MENTION_USER_ID: "REPLACE_ME"
  DISCORD_ALERT_MENTION_USER_AWAY_UNTIL: "REPLACE_ME"
  # ── вебхук remediation (HMAC) ──────────────────────────────────────────
  REMEDIATION_WEBHOOK_SECRET: "REPLACE_ME"
  # ── TeamCity ───────────────────────────────────────────────────────────
  TC_URL: "REPLACE_ME"
  TC_TOKEN: "REPLACE_ME"
  TC_PROJECT_IDS: "REPLACE_ME"
  TC_BACKEND_PROJECT_ID: "REPLACE_ME"
  TEAMCITY_WEB_URL: "REPLACE_ME"
  # ── GitLab ─────────────────────────────────────────────────────────────
  GITLAB_URL: "REPLACE_ME"
  GITLAB_TOKEN: "REPLACE_ME"
  # ── Jira ───────────────────────────────────────────────────────────────
  JIRA_BASE_URL: "REPLACE_ME"
  JIRA_EMAIL: "REPLACE_ME"
  JIRA_API_TOKEN: "REPLACE_ME"
  JIRA_PROJECT_KEY: "REPLACE_ME"
  # ── ClickHouse (prod, blast radius) ────────────────────────────────────
  CH_PROD_HOST: "REPLACE_ME"
  CH_PROD_PORT: "REPLACE_ME"
  CH_PROD_USER: "REPLACE_ME"
  CH_PROD_PASSWORD: "REPLACE_ME"
  # ── Statics Postgres ───────────────────────────────────────────────────
  STATICS_HOST: "REPLACE_ME"
  STATICS_PORT: "REPLACE_ME"
  STATICS_USER: "REPLACE_ME"
  STATICS_PASSWORD: "REPLACE_ME"
  # ── наблюдаемость ──────────────────────────────────────────────────────
  SEQ_INSTANCES: "REPLACE_ME"
  VICTORIA_METRICS_URL: "REPLACE_ME"
  OTLP_EXPORTER_ENDPOINT: "REPLACE_ME"
